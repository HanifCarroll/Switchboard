#!/usr/bin/env bash
set -euo pipefail

repository="$(cd "$(dirname "$0")/.." && pwd)"
investigation_mode="${SWITCHBOARD_INVESTIGATION_MODE:-fixture}"
container_id=""
api_pid=""
web_pid=""

cleanup() {
  [[ -z "$api_pid" ]] || kill "$api_pid" 2>/dev/null || true
  [[ -z "$web_pid" ]] || kill "$web_pid" 2>/dev/null || true
  [[ -z "$container_id" ]] || docker stop "$container_id" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# 1. Start persistent DynamoDB Local; credentials and the endpoint stay local.
export AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local AWS_DEFAULT_REGION=us-east-1
export AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:8001 DYNAMODB_TABLE=switchboard-local
export AWS_MAX_ATTEMPTS=2
unset AWS_PROFILE AWS_SESSION_TOKEN INVESTIGATION_QUEUE_URL INVESTIGATION_DLQ_URL
container_id=$(docker run --detach --rm --name switchboard-dynamodb-local \
  --user 0:0 \
  --publish 127.0.0.1:8001:8000 \
  --volume switchboard-local-data:/home/dynamodblocal/data \
  amazon/dynamodb-local:3.3.0 -jar DynamoDBLocal.jar -sharedDb -dbPath ./data -disableTelemetry)
for _ in {1..60}; do
  if curl --silent --output /dev/null "$AWS_ENDPOINT_URL_DYNAMODB"; then break; fi
  sleep 1
done
if ! aws dynamodb describe-table --table-name "$DYNAMODB_TABLE" --cli-read-timeout 5 --no-cli-pager >/dev/null 2>&1; then
  aws dynamodb create-table --table-name "$DYNAMODB_TABLE" \
    --attribute-definitions AttributeName=PK,AttributeType=S AttributeName=SK,AttributeType=S \
    --key-schema AttributeName=PK,KeyType=HASH AttributeName=SK,KeyType=RANGE \
    --provisioned-throughput ReadCapacityUnits=25,WriteCapacityUnits=25 \
    --cli-read-timeout 5 --no-cli-pager >/dev/null
fi

# 2. Run the same API and website, using synchronous fixture investigations locally.
(
  cd "$repository/backend"
  exec env SWITCHBOARD_AUTH_MODE=demo SWITCHBOARD_RUNTIME=local \
    SWITCHBOARD_INVESTIGATION_MODE="$investigation_mode" \
    uv run uvicorn switchboard.api:app --reload --host 127.0.0.1 --port 8000
) &
api_pid=$!
(
  cd "$repository/frontend"
  exec env ./node_modules/.bin/next dev --hostname 127.0.0.1
) &
web_pid=$!
wait
