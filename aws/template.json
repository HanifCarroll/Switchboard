{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Switchboard application storage, queues, Lambda functions, observability, and execution roles.",
  "Resources": {
    "Database": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "switchboard",
        "BillingMode": "PROVISIONED",
        "TableClass": "STANDARD",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 25,
          "WriteCapacityUnits": 25
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DeadLetters": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "switchboard-failed",
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "Investigations": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "switchboard-investigations",
        "VisibilityTimeout": 1800,
        "MessageRetentionPeriod": 345600,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadLetters",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "APILogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/switchboard-api",
        "RetentionInDays": 7
      }
    },
    "APIRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "switchboard-api",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/switchboard-api:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:ConditionCheckItem",
                    "dynamodb:Scan",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Database",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Investigations",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "DeadLetters",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "API": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "switchboard-api",
        "Role": {
          "Fn::GetAtt": [
            "APIRole",
            "Arn"
          ]
        },
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Timeout": 120,
        "MemorySize": 512,
        "Architectures": [
          "x86_64"
        ],
        "LoggingConfig": {
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "APILogs"
          },
          "ApplicationLogLevel": "INFO"
        },
        "Code": {
          "ZipFile": "def handler(event, context):\n    return {\"statusCode\":503,\"body\":\"Deployment pending\"}"
        },
        "TracingConfig": {
          "Mode": "Active"
        }
      }
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/switchboard-worker",
        "RetentionInDays": 7
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "switchboard-worker",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/switchboard-worker:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:ConditionCheckItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Database",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Investigations",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": "arn:aws:bedrock:us-east-1::foundation-model/deepseek.v3.2"
                }
              ]
            }
          }
        ]
      }
    },
    "Worker": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "switchboard-worker",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Timeout": 300,
        "MemorySize": 1024,
        "Architectures": [
          "x86_64"
        ],
        "LoggingConfig": {
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "WorkerLogs"
          },
          "ApplicationLogLevel": "INFO"
        },
        "Code": {
          "ZipFile": "def handler(event, context):\n    return {\"statusCode\":503,\"body\":\"Deployment pending\"}"
        },
        "TracingConfig": {
          "Mode": "Active"
        }
      }
    },
    "WebsiteLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/switchboard-website",
        "RetentionInDays": 7
      }
    },
    "WebsiteRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "switchboard-website",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/switchboard-website:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "Website": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "switchboard-website",
        "Role": {
          "Fn::GetAtt": [
            "WebsiteRole",
            "Arn"
          ]
        },
        "Runtime": "nodejs24.x",
        "Handler": "index.handler",
        "Timeout": 30,
        "MemorySize": 512,
        "Architectures": [
          "x86_64"
        ],
        "LoggingConfig": {
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "WebsiteLogs"
          }
        },
        "Code": {
          "ZipFile": "exports.handler = async () => ({statusCode:503,body:\"Deployment pending\"});"
        },
        "TracingConfig": {
          "Mode": "Active"
        }
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "switchboard-scheduler",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:aws:scheduler:${AWS::Region}:${AWS::AccountId}:schedule-group/default"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeMaintenance",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::Sub": "${API.Arn}:live"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "GitHubOIDC": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "switchboard-deployment",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOIDC"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:HanifCarroll@26860300/b2b-saas-internal-agent@1375983110:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReleaseExistingFunctions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:GetFunction",
                    "lambda:GetFunctionConfiguration",
                    "lambda:UpdateFunctionConfiguration",
                    "lambda:UpdateFunctionCode",
                    "lambda:PublishVersion",
                    "lambda:GetAlias",
                    "lambda:CreateAlias",
                    "lambda:UpdateAlias"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:switchboard-api"
                    },
                    {
                      "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:switchboard-api:*"
                    },
                    {
                      "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:switchboard-worker"
                    },
                    {
                      "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:switchboard-worker:*"
                    },
                    {
                      "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:switchboard-website"
                    },
                    {
                      "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:switchboard-website:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeStacks",
                  "Resource": {
                    "Ref": "AWS::StackId"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "lambda:GetLayerVersion",
                  "Resource": [
                    "arn:aws:lambda:us-east-1:753240598075:layer:LambdaAdapterLayerX86:30",
                    "arn:aws:lambda:us-east-1:901920570463:layer:aws-otel-python-amd64-ver-1-32-0:7"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "switchboard-alerts",
        "DisplayName": "Switchboard operational alerts"
      }
    },
    "AlertSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasAlertEmail",
      "Properties": {
        "TopicArn": {
          "Ref": "Alerts"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        }
      }
    },
    "APIErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "switchboard-APIErrors",
        "AlarmDescription": "See the Switchboard dashboard and AWS operations guide for investigation and recovery.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": "switchboard-api"
          }
        ]
      }
    },
    "WorkerErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "switchboard-WorkerErrors",
        "AlarmDescription": "See the Switchboard dashboard and AWS operations guide for investigation and recovery.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": "switchboard-worker"
          }
        ]
      }
    },
    "WebsiteErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "switchboard-WebsiteErrors",
        "AlarmDescription": "See the Switchboard dashboard and AWS operations guide for investigation and recovery.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": "switchboard-website"
          }
        ]
      }
    },
    "QueueBacklogAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "switchboard-QueueBacklog",
        "AlarmDescription": "See the Switchboard dashboard and AWS operations guide for investigation and recovery.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateAgeOfOldestMessage",
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 900,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": "switchboard-investigations"
          }
        ]
      }
    },
    "DeadLetterJobsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "switchboard-DeadLetterJobs",
        "AlarmDescription": "See the Switchboard dashboard and AWS operations guide for investigation and recovery.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": "switchboard-failed"
          }
        ]
      }
    },
    "RejectedJobsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "switchboard-RejectedJobs",
        "AlarmDescription": "See the Switchboard dashboard and AWS operations guide for investigation and recovery.",
        "Namespace": "Switchboard",
        "MetricName": "FailedInvestigations",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "FailedJobsMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "WorkerLogs"
        },
        "FilterPattern": "{ $.message = \"Investigation rejected\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": "Switchboard",
            "MetricName": "FailedInvestigations",
            "MetricValue": "1",
            "DefaultValue": 0,
            "Unit": "Count"
          }
        ]
      }
    },
    "Dashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": "switchboard",
        "DashboardBody": "{\"widgets\": [{\"type\": \"metric\", \"x\": 0, \"y\": 0, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Lambda invocations and errors\", \"region\": \"us-east-1\", \"period\": 300, \"stat\": \"Sum\", \"metrics\": [[\"AWS/Lambda\", \"Invocations\", \"FunctionName\", \"switchboard-api\"], [\"AWS/Lambda\", \"Errors\", \"FunctionName\", \"switchboard-api\"], [\"AWS/Lambda\", \"Throttles\", \"FunctionName\", \"switchboard-api\"], [\"AWS/Lambda\", \"Invocations\", \"FunctionName\", \"switchboard-worker\"], [\"AWS/Lambda\", \"Errors\", \"FunctionName\", \"switchboard-worker\"], [\"AWS/Lambda\", \"Throttles\", \"FunctionName\", \"switchboard-worker\"], [\"AWS/Lambda\", \"Invocations\", \"FunctionName\", \"switchboard-website\"], [\"AWS/Lambda\", \"Errors\", \"FunctionName\", \"switchboard-website\"], [\"AWS/Lambda\", \"Throttles\", \"FunctionName\", \"switchboard-website\"]]}}, {\"type\": \"metric\", \"x\": 0, \"y\": 6, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Lambda duration\", \"region\": \"us-east-1\", \"period\": 300, \"stat\": \"p95\", \"metrics\": [[\"AWS/Lambda\", \"Duration\", \"FunctionName\", \"switchboard-api\"], [\"AWS/Lambda\", \"Duration\", \"FunctionName\", \"switchboard-worker\"], [\"AWS/Lambda\", \"Duration\", \"FunctionName\", \"switchboard-website\"]]}}, {\"type\": \"metric\", \"x\": 0, \"y\": 12, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Investigation queues\", \"region\": \"us-east-1\", \"period\": 300, \"stat\": \"Maximum\", \"metrics\": [[\"AWS/SQS\", \"ApproximateNumberOfMessagesVisible\", \"QueueName\", \"switchboard-investigations\"], [\"AWS/SQS\", \"ApproximateNumberOfMessagesNotVisible\", \"QueueName\", \"switchboard-investigations\"], [\"AWS/SQS\", \"ApproximateAgeOfOldestMessage\", \"QueueName\", \"switchboard-investigations\"], [\"AWS/SQS\", \"ApproximateNumberOfMessagesVisible\", \"QueueName\", \"switchboard-failed\"], [\"AWS/SQS\", \"ApproximateNumberOfMessagesNotVisible\", \"QueueName\", \"switchboard-failed\"], [\"AWS/SQS\", \"ApproximateAgeOfOldestMessage\", \"QueueName\", \"switchboard-failed\"]]}}, {\"type\": \"metric\", \"x\": 0, \"y\": 18, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"DynamoDB capacity and throttling\", \"region\": \"us-east-1\", \"period\": 300, \"stat\": \"Sum\", \"metrics\": [[\"AWS/DynamoDB\", \"ConsumedReadCapacityUnits\", \"TableName\", \"switchboard\"], [\"AWS/DynamoDB\", \"ConsumedWriteCapacityUnits\", \"TableName\", \"switchboard\"], [\"AWS/DynamoDB\", \"ReadThrottleEvents\", \"TableName\", \"switchboard\"], [\"AWS/DynamoDB\", \"WriteThrottleEvents\", \"TableName\", \"switchboard\"]]}}, {\"type\": \"metric\", \"x\": 0, \"y\": 24, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Bedrock invocations and tokens\", \"region\": \"us-east-1\", \"period\": 300, \"stat\": \"Sum\", \"metrics\": [[\"AWS/Bedrock\", \"Invocations\", \"ModelId\", \"deepseek.v3.2\"], [\"AWS/Bedrock\", \"InvocationClientErrors\", \"ModelId\", \"deepseek.v3.2\"], [\"AWS/Bedrock\", \"InvocationServerErrors\", \"ModelId\", \"deepseek.v3.2\"], [\"AWS/Bedrock\", \"InvocationThrottles\", \"ModelId\", \"deepseek.v3.2\"], [\"AWS/Bedrock\", \"InputTokenCount\", \"ModelId\", \"deepseek.v3.2\"], [\"AWS/Bedrock\", \"OutputTokenCount\", \"ModelId\", \"deepseek.v3.2\"]]}}, {\"type\": \"metric\", \"x\": 0, \"y\": 30, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Rejected investigations\", \"region\": \"us-east-1\", \"period\": 300, \"stat\": \"Sum\", \"metrics\": [[\"Switchboard\", \"FailedInvestigations\"]]}}]}"
      }
    },
    "AlertsPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "Alerts"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "Alerts"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:switchboard-*"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Database": {
      "Value": {
        "Ref": "Database"
      }
    },
    "Investigations": {
      "Value": {
        "Ref": "Investigations"
      }
    },
    "DeadLetters": {
      "Value": {
        "Ref": "DeadLetters"
      }
    },
    "APIArn": {
      "Value": {
        "Fn::GetAtt": [
          "API",
          "Arn"
        ]
      }
    },
    "WorkerArn": {
      "Value": {
        "Fn::GetAtt": [
          "Worker",
          "Arn"
        ]
      }
    },
    "WebsiteArn": {
      "Value": {
        "Fn::GetAtt": [
          "Website",
          "Arn"
        ]
      }
    },
    "SchedulerRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "SchedulerRole",
          "Arn"
        ]
      }
    },
    "DeploymentRoleArn": {
